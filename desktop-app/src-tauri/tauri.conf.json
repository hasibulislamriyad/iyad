{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch",
  "version": "0.1.0",
  "identifier": "app.notch.companion",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [{
      "label": "main", "title": "Notch", "width": 320, "height": 56, "x": 0, "y": 0,
      "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true,
      "resizable": true, "shadow": true, "focus": false
    }]
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.png"] }
}
